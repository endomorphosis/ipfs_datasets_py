+def _pick_repo_shards(filenames: set[str], name: str) -> list[str]:
+    """Sharded raw repos: data/<name>-00001.parquet, data/<name>-delta-00001.parquet, ... (sorted)."""
+    import re as _re
+
+    pat = _re.compile(rf"^data/{name}(?:-[\w-]+)?\.parquet$")
+    return sorted(f for f in filenames if pat.match(f))
+
+
+def _read_shards(paths: list[Path]) -> pd.DataFrame:
+    """Concatenate shards (raw repos pin one schema per repo; mixed string/large_string is fine in pandas)."""
+    frames = [pd.read_parquet(p) for p in paths]
+    return pd.concat(frames, ignore_index=True) if len(frames) > 1 else frames[0]
+
