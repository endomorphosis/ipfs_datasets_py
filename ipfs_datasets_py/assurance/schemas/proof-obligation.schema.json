    },
    "logic_family": { "type": "string", "minLength": 1 },
    "metadata": { "additionalProperties": true, "type": "object" },
    "obligation_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "ir-proof-obligation/v1" },
    "source_refs": {
      "items": { "type": "string", "minLength": 1 },
      "type": "array"
    },
    "statement": { "type": "string", "minLength": 1 }
  },
  "required": ["obligation_id", "schema_version", "statement"],
  "title": "ProofObligation@1",
  "type": "object",
  "x-interface": "ProofObligation@1",
