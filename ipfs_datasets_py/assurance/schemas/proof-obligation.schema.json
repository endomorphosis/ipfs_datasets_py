{
  "$id": "https://schemas.ipfs-datasets.dev/assurance/proof-obligation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Packaged ProofObligation@1. Theorem-shaped declaration with no implied verification.",
  "properties": {
