{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipfs-datasets.local/schemas/intent-ir/v1",
  "title": "Intent IR v1",
  "description": "Closed, source-grounded semantic intent contract. Cross-reference and statement-role constraints are additionally enforced by the versioned decoder.",
  "type": "object",
  "additionalProperties": false,
  "x-extension-policy": "closed",
  "required": [
    "schema_version",
    "document_id",
    "title",
    "intent_kind",
    "sources",
    "statements"
  ],
  "properties": {
    "schema_version": {
      "const": "intent-ir/v1"
    },
    "document_id": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "intent_kind": {
      "enum": [
        "procedure",
        "capability",
        "policy",
        "declarative"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "items": {
        "$ref": "#/$defs/sourceRef"
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "goal"
          }
        }
      },
      "items": {
        "$ref": "#/$defs/statement"
      }
    },
    "actions": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "control_edges": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "items": {
        "$ref": "#/$defs/controlEdge"
      }
    },
    "entry_action_ids": {
      "$ref": "#/$defs/identifierSet"
    },
    "terminal_action_ids": {
      "$ref": "#/$defs/identifierSet"
    },
    "tags": {
      "$ref": "#/$defs/stringSet"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "intent_kind": {
            "const": "procedure"
          }
        },
        "required": [
          "intent_kind"
        ]
      },
      "then": {
        "required": [
          "actions",
          "entry_action_ids",
          "terminal_action_ids"
        ],
        "properties": {
          "actions": {
            "minItems": 1
          },
          "entry_action_ids": {
            "minItems": 1
          },
          "terminal_action_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewStatus": {
      "enum": [
        "unreviewed",
        "machine_extracted",
        "human_reviewed",
        "trusted_fixture",
        "quarantined"
      ]
    },
    "grounding": {
      "enum": [
        "grounded",
        "inferred"
      ]
    },
    "stringSet": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "identifierSet": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "x-collection-semantics": "set-like",
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_char",
        "end_char"
      ],
      "properties": {
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "source_uri",
        "source_id",
        "source_revision",
        "content_sha256"
      ],
      "properties": {
        "ref_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_uri": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "container_uri": {
          "type": "string",
          "default": ""
        },
        "container_sha256": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ],
          "default": ""
        },
        "content_cid": {
          "type": "string",
          "default": ""
        },
        "license_expression": {
          "type": "string",
          "default": ""
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus",
          "default": "unreviewed"
        },
        "span": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourceSpan"
            }
          ],
          "default": null
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "kind",
        "modality",
        "normalized_text",
        "source_ref_ids",
        "grounding"
      ],
      "properties": {
        "statement_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "goal",
            "precondition",
            "postcondition",
            "invariant",
            "guard",
            "effect",
            "assumption",
            "failure",
            "verification"
          ]
        },
        "modality": {
          "enum": [
            "asserted",
            "intended",
            "required",
            "recommended",
            "permitted",
            "prohibited"
          ]
        },
        "normalized_text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source_ref_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "predicate": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ],
          "default": ""
        },
        "arguments": {
          "type": "array",
          "default": [],
          "x-collection-semantics": "ordered",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "review_status": {
          "$ref": "#/$defs/reviewStatus",
          "default": "machine_extracted"
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grounding": {
                "const": "grounded"
              }
            },
            "required": [
              "grounding"
            ]
          },
          "then": {
            "properties": {
              "source_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "actor",
        "verb",
        "object_refs",
        "source_ref_ids",
        "grounding"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/identifier"
        },
        "actor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verb": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "object_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "source_ref_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "tool_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "input_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "output_refs": {
          "$ref": "#/$defs/stringSet"
        },
        "precondition_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "effect_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "verification_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grounding": {
                "const": "grounded"
              }
            },
            "required": [
              "grounding"
            ]
          },
          "then": {
            "properties": {
              "source_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "controlEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_action_id",
        "target_action_id",
        "grounding"
      ],
      "properties": {
        "edge_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_action_id": {
          "$ref": "#/$defs/identifier"
        },
        "target_action_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "next",
            "on_success",
            "on_failure",
            "conditional",
            "retry",
            "parallel",
            "join"
          ],
          "default": "next"
        },
        "guard_statement_id": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ],
          "default": ""
        },
        "source_ref_ids": {
          "$ref": "#/$defs/identifierSet"
        },
        "grounding": {
          "$ref": "#/$defs/grounding"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grounding": {
                "const": "grounded"
              }
            },
            "required": [
              "grounding"
            ]
          },
          "then": {
            "properties": {
              "source_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
