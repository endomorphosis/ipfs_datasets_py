{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipfs-datasets.dev/schemas/semantic-state/task-contract.schema.json",
  "title": "Closed semantic task-plan contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "interface", "producer", "task_id", "objective_revision", "repository_commit", "repository_tree", "policy_identity", "assumptions", "guarantees", "cone", "interfaces", "permitted_paths", "side_effects", "acceptance", "validation", "questions", "obligations", "budget", "fallback", "recovery", "completeness_witness", "task_contract_cid"],
  "properties": {
    "schema": {"const": "aseh/task-contract@1"},
    "interface": {"const": "SemanticTaskContract@1"},
    "producer": {"const": "ipfs_datasets_py.logic.software_contracts.semantic_state.task_contract"},
    "task_id": {"$ref": "#/$defs/text"},
    "objective_revision": {"$ref": "#/$defs/text"},
    "repository_commit": {"$ref": "#/$defs/gitOid"},
    "repository_tree": {"$ref": "#/$defs/gitOid"},
    "policy_identity": {"$ref": "#/$defs/text"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "guarantees": {"type": "array", "items": {"$ref": "#/$defs/guarantee"}},
    "cone": {"$ref": "#/$defs/cone"},
    "interfaces": {"$ref": "#/$defs/textList"},
    "permitted_paths": {"$ref": "#/$defs/pathList"},
    "side_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "acceptance": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "validation": {"$ref": "#/$defs/validation"},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "budget": {"$ref": "#/$defs/budget"},
    "fallback": {"$ref": "#/$defs/fallback"},
    "recovery": {"$ref": "#/$defs/recovery"},
    "completeness_witness": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/witness"}]},
    "task_contract_cid": {"$ref": "#/$defs/cid"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 16384},
    "cid": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^b[a-z2-7]+$"},
    "gitOid": {"type": "string", "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.{1,2}(/|$)).+$"},
    "textList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "pathList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "statement"], "properties": {"id": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}}},
    "guarantee": {"type": "object", "additionalProperties": false, "required": ["id", "statement", "under_assumptions"], "properties": {"id": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}, "under_assumptions": {"$ref": "#/$defs/textList"}}},
    "cone": {"type": "object", "additionalProperties": false, "required": ["affected_symbols", "affected_paths", "dependencies", "dependents"], "properties": {"affected_symbols": {"$ref": "#/$defs/textList"}, "affected_paths": {"$ref": "#/$defs/pathList"}, "dependencies": {"$ref": "#/$defs/textList"}, "dependents": {"$ref": "#/$defs/textList"}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "paths", "description"], "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["read", "write", "delete", "rename", "execute"]}, "paths": {"$ref": "#/$defs/pathList"}, "description": {"$ref": "#/$defs/text"}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["tests", "proofs"], "properties": {"tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}, "proofs": {"type": "array", "items": {"$ref": "#/$defs/proof"}}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["id", "command"], "properties": {"id": {"$ref": "#/$defs/text"}, "command": {"$ref": "#/$defs/text"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["id", "claim"], "properties": {"id": {"$ref": "#/$defs/text"}, "claim": {"$ref": "#/$defs/text"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "question", "blocking"], "properties": {"id": {"$ref": "#/$defs/text"}, "question": {"$ref": "#/$defs/text"}, "blocking": {"type": "boolean"}}},
    "obligation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "subject_id", "required"], "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["acceptance", "test", "proof"]}, "subject_id": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_tokens", "max_tool_calls", "max_wall_time_seconds", "validation_reserve"], "properties": {"max_tokens": {"$ref": "#/$defs/positiveInt"}, "max_tool_calls": {"$ref": "#/$defs/positiveInt"}, "max_wall_time_seconds": {"$ref": "#/$defs/positiveInt"}, "validation_reserve": {"$ref": "#/$defs/reserve"}}},
    "positiveInt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "reserve": {"type": "object", "additionalProperties": false, "required": ["max_tokens", "max_tool_calls", "max_wall_time_seconds"], "properties": {"max_tokens": {"$ref": "#/$defs/positiveInt"}, "max_tool_calls": {"$ref": "#/$defs/positiveInt"}, "max_wall_time_seconds": {"$ref": "#/$defs/positiveInt"}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["trigger", "action"], "properties": {"trigger": {"$ref": "#/$defs/text"}, "action": {"$ref": "#/$defs/text"}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["trigger", "rollback", "retry"], "properties": {"trigger": {"$ref": "#/$defs/text"}, "rollback": {"$ref": "#/$defs/text"}, "retry": {"$ref": "#/$defs/text"}}},
    "witness": {"type": "object", "additionalProperties": false, "required": ["schema", "witness_cid", "task_id", "objective_revision", "repository_commit", "repository_tree", "policy_identity", "obligation_ids"], "properties": {"schema": {"const": "aseh/completeness-witness@1"}, "witness_cid": {"$ref": "#/$defs/cid"}, "task_id": {"$ref": "#/$defs/text"}, "objective_revision": {"$ref": "#/$defs/text"}, "repository_commit": {"$ref": "#/$defs/gitOid"}, "repository_tree": {"$ref": "#/$defs/gitOid"}, "policy_identity": {"$ref": "#/$defs/text"}, "obligation_ids": {"$ref": "#/$defs/textList"}}}
  }
}
