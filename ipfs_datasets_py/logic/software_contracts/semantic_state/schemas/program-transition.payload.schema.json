{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipfs-datasets.dev/schemas/program-transition.payload.schema.json",
  "title": "Program-transition contracts and admission v1",
  "description": "Closed, fail-closed JSON Schema for datasets-owned proposal-only program-transition query, candidate, prediction, observation, admission, receipt, model-profile, calibration, repair-operator, graph-delta proposal, and patch-sketch records. Predictions cannot prove contracts or postconditions, authorize mutation, suppress validation or review, establish equivalence, observation, or completion, or invent hashes. Model output may only select or parameterize a bounded candidate. Canonical bytes and CIDv1 come from software_contracts.content over ir_core collection-canonical DAG-JSON. Unknown fields, unsupported schema versions, floats, and nonfinite numbers are rejected.",
  "oneOf": [
    { "$ref": "#/$defs/transitionModelProfile" },
    { "$ref": "#/$defs/transitionCalibration" },
    { "$ref": "#/$defs/repairOperator" },
    { "$ref": "#/$defs/programGraphDeltaProposal" },
    { "$ref": "#/$defs/patchSketchIR" },
    { "$ref": "#/$defs/programTransitionQuery" },
    { "$ref": "#/$defs/programTransitionCandidate" },
    { "$ref": "#/$defs/programTransitionPrediction" },
    { "$ref": "#/$defs/programTransitionObservation" },
    { "$ref": "#/$defs/programTransitionAdmission" },
    { "$ref": "#/$defs/programTransitionReceipt" }
  ],
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^b[a-z2-7]+$"
    },
    "cidOrNull": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cid" }]
    },
    "nfcString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "cidArraySet": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/cid" }
    },
    "cidArrayOrdered": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/cid" }
    },
    "cidArrayOrderedBounded": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/cid" }
    },
    "cidArrayOrderedSketch": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/cid" }
    },
    "nfcStringSet": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nfcString" }
    },
    "nonnegInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "strictDagJson": {
      "description": "Strict DAG-JSON value: null, bool, safe int, string, array, or string-keyed object. Floats and host types are rejected by the Python decoder.",
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "string", "maxLength": 16384 },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/strictDagJson" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/strictDagJson" }
        }
      ]
    },
    "strictObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/strictDagJson" }
    },
    "programLanguage": {
      "type": "string",
      "enum": ["python"]
    },
    "queryFamily": {
      "type": "string",
      "enum": ["next_call", "next_event", "inverse_trace", "repair"]
    },
    "candidateKind": {
      "type": "string",
      "enum": [
        "call_target",
        "next_event",
        "next_state",
        "inverse_event",
        "inverse_trace",
        "repair_operator",
        "graph_delta",
        "patch_sketch"
      ]
    },
    "repairOperatorKind": {
      "type": "string",
      "enum": [
        "replace_call_target",
        "insert_guard",
        "wrap_handler",
        "strengthen_precondition",
        "weaken_postcondition",
        "rewrite_assignment",
        "delete_dead_code",
        "normalize_egraph",
        "bounded_cegis",
        "no_op"
      ]
    },
    "observationStatus": {
      "type": "string",
      "enum": ["observed", "unavailable", "redacted", "inferred_untrusted"]
    },
    "admissionVerdict": {
      "type": "string",
      "enum": ["admitted", "rejected", "abstain", "conflict", "stale", "unknown"]
    },
    "calibrationStatus": {
      "type": "string",
      "enum": ["calibrated", "drifted", "uncalibrated", "unavailable"]
    },
    "specialistFamily": {
      "type": "string",
      "enum": ["call_target", "next_event", "inverse_trace", "repair"]
    },
    "sketchKind": {
      "type": "string",
      "enum": ["repair", "delta", "call_target"]
    },
    "forbiddenAuthorityFields": {
      "not": {
        "anyOf": [
          { "required": ["embedding"] },
          { "required": ["embeddings"] },
          { "required": ["similarity"] },
          { "required": ["score"] },
          { "required": ["scores"] },
          { "required": ["knn"] },
          { "required": ["nearest"] },
          { "required": ["distance"] },
          { "required": ["invented_hash"] },
          { "required": ["fabricated_cid"] },
          { "required": ["predicted_hash"] },
          { "required": ["content_hash"] },
          { "required": ["sha256"] },
          { "required": ["md5"] },
          { "required": ["timestamp"] },
          { "required": ["wall_clock"] }
        ]
      }
    },
    "transitionModelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile_name",
        "specialist_family",
        "model_cid",
        "tokenizer_cid",
        "preprocessing_profile_cid",
        "abstain_on_ood",
        "proposal_only",
        "authoritative",
        "model_profile_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.transition-model-profile@1"
        },
        "profile_name": { "$ref": "#/$defs/nfcString" },
        "specialist_family": { "$ref": "#/$defs/specialistFamily" },
        "model_cid": { "$ref": "#/$defs/cid" },
        "tokenizer_cid": { "$ref": "#/$defs/cid" },
        "preprocessing_profile_cid": { "$ref": "#/$defs/cid" },
        "abstain_on_ood": { "const": true },
        "proposal_only": { "const": true },
        "authoritative": { "const": false },
        "model_profile_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "transitionCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "model_profile_cid",
        "query_family",
        "trial_count",
        "disagreement_count",
        "bound_numerator",
        "bound_denominator",
        "expected_observation_cid",
        "actual_observation_cid",
        "status",
        "calibration_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.transition-calibration@1"
        },
        "model_profile_cid": { "$ref": "#/$defs/cid" },
        "query_family": { "$ref": "#/$defs/queryFamily" },
        "trial_count": { "$ref": "#/$defs/nonnegInt" },
        "disagreement_count": { "$ref": "#/$defs/nonnegInt" },
        "bound_numerator": { "$ref": "#/$defs/nonnegInt" },
        "bound_denominator": { "$ref": "#/$defs/positiveInt" },
        "expected_observation_cid": { "$ref": "#/$defs/cidOrNull" },
        "actual_observation_cid": { "$ref": "#/$defs/cidOrNull" },
        "status": { "$ref": "#/$defs/calibrationStatus" },
        "calibration_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "repairOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operator_kind",
        "language",
        "target_symbol_cid",
        "parameter_cids",
        "pre_state_cid",
        "proposal_only",
        "authorizes_mutation",
        "bounded",
        "repair_operator_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.repair-operator@1"
        },
        "operator_kind": { "$ref": "#/$defs/repairOperatorKind" },
        "language": { "$ref": "#/$defs/programLanguage" },
        "target_symbol_cid": { "$ref": "#/$defs/cid" },
        "parameter_cids": { "$ref": "#/$defs/cidArraySet" },
        "pre_state_cid": { "$ref": "#/$defs/cidOrNull" },
        "proposal_only": { "const": true },
        "authorizes_mutation": { "const": false },
        "bounded": { "const": true },
        "repair_operator_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "programGraphDeltaProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "previous_snapshot_cid",
        "query_cid",
        "candidate_cid",
        "added_node_cids",
        "removed_node_cids",
        "added_edge_cids",
        "removed_edge_cids",
        "retained_subroot_cids",
        "proposal_only",
        "authorizes_mutation",
        "program_graph_delta_proposal_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-graph-delta-proposal@1"
        },
        "previous_snapshot_cid": { "$ref": "#/$defs/cid" },
        "query_cid": { "$ref": "#/$defs/cid" },
        "candidate_cid": { "$ref": "#/$defs/cid" },
        "added_node_cids": { "$ref": "#/$defs/cidArraySet" },
        "removed_node_cids": { "$ref": "#/$defs/cidArraySet" },
        "added_edge_cids": { "$ref": "#/$defs/cidArraySet" },
        "removed_edge_cids": { "$ref": "#/$defs/cidArraySet" },
        "retained_subroot_cids": { "$ref": "#/$defs/cidArraySet" },
        "proposal_only": { "const": true },
        "authorizes_mutation": { "const": false },
        "program_graph_delta_proposal_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "patchSketchIR": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "language",
        "sketch_kind",
        "source_cid",
        "hole_cids",
        "operator_cids",
        "proposal_only",
        "authorizes_mutation",
        "complete_patch",
        "patch_sketch_ir_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.patch-sketch-ir@1"
        },
        "language": { "$ref": "#/$defs/programLanguage" },
        "sketch_kind": { "$ref": "#/$defs/sketchKind" },
        "source_cid": { "$ref": "#/$defs/cid" },
        "hole_cids": { "$ref": "#/$defs/cidArrayOrderedSketch" },
        "operator_cids": { "$ref": "#/$defs/cidArrayOrderedSketch" },
        "proposal_only": { "const": true },
        "authorizes_mutation": { "const": false },
        "complete_patch": { "const": false },
        "patch_sketch_ir_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "programTransitionQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_family",
        "language",
        "subject_cid",
        "current_source_cid",
        "current_graph_cid",
        "current_state_cid",
        "current_trace_cid",
        "environment_binding_cid",
        "policy_cid",
        "abstraction_profile_cid",
        "allowed_symbol_cids",
        "allowed_operator_cids",
        "evidence_cids",
        "unavailable_dimensions",
        "query_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-query@1"
        },
        "query_family": { "$ref": "#/$defs/queryFamily" },
        "language": { "$ref": "#/$defs/programLanguage" },
        "subject_cid": { "$ref": "#/$defs/cid" },
        "current_source_cid": { "$ref": "#/$defs/cid" },
        "current_graph_cid": { "$ref": "#/$defs/cidOrNull" },
        "current_state_cid": { "$ref": "#/$defs/cidOrNull" },
        "current_trace_cid": { "$ref": "#/$defs/cidOrNull" },
        "environment_binding_cid": { "$ref": "#/$defs/cid" },
        "policy_cid": { "$ref": "#/$defs/cid" },
        "abstraction_profile_cid": { "$ref": "#/$defs/cidOrNull" },
        "allowed_symbol_cids": { "$ref": "#/$defs/cidArraySet" },
        "allowed_operator_cids": { "$ref": "#/$defs/cidArraySet" },
        "evidence_cids": { "$ref": "#/$defs/cidArraySet" },
        "unavailable_dimensions": { "$ref": "#/$defs/nfcStringSet" },
        "query_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [
        { "$ref": "#/$defs/forbiddenAuthorityFields" },
        {
          "if": {
            "properties": { "query_family": { "enum": ["next_call", "next_event"] } },
            "required": ["query_family"]
          },
          "then": {
            "properties": {
              "current_state_cid": { "$ref": "#/$defs/cid" }
            }
          }
        },
        {
          "if": {
            "properties": { "query_family": { "const": "inverse_trace" } },
            "required": ["query_family"]
          },
          "then": {
            "properties": {
              "current_trace_cid": { "$ref": "#/$defs/cid" }
            }
          }
        },
        {
          "if": {
            "properties": { "query_family": { "const": "repair" } },
            "required": ["query_family"]
          },
          "then": {
            "properties": {
              "current_graph_cid": { "$ref": "#/$defs/cid" }
            }
          }
        }
      ]
    },
    "programTransitionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_cid",
        "candidate_kind",
        "selected_cid",
        "query_family",
        "current_subject_cid",
        "current_source_cid",
        "current_environment_binding_cid",
        "current_graph_cid",
        "current_state_cid",
        "current_trace_cid",
        "parameterization",
        "rank",
        "proposal_only",
        "candidate_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-candidate@1"
        },
        "query_cid": { "$ref": "#/$defs/cid" },
        "candidate_kind": { "$ref": "#/$defs/candidateKind" },
        "selected_cid": { "$ref": "#/$defs/cid" },
        "query_family": { "$ref": "#/$defs/queryFamily" },
        "current_subject_cid": { "$ref": "#/$defs/cid" },
        "current_source_cid": { "$ref": "#/$defs/cid" },
        "current_environment_binding_cid": { "$ref": "#/$defs/cid" },
        "current_graph_cid": { "$ref": "#/$defs/cidOrNull" },
        "current_state_cid": { "$ref": "#/$defs/cidOrNull" },
        "current_trace_cid": { "$ref": "#/$defs/cidOrNull" },
        "parameterization": { "$ref": "#/$defs/strictObject" },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "proposal_only": { "const": true },
        "candidate_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [{ "$ref": "#/$defs/forbiddenAuthorityFields" }]
    },
    "programTransitionPrediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_cid",
        "subject_cid",
        "model_profile_cid",
        "candidate_cids",
        "evidence_cids",
        "environment_binding_cid",
        "policy_cid",
        "calibration_cid",
        "abstain",
        "proposal_only",
        "proves_contract",
        "proves_postcondition",
        "authorizes_mutation",
        "suppresses_validation",
        "suppresses_review",
        "establishes_equivalence",
        "establishes_observation",
        "establishes_completion",
        "invents_hashes",
        "proves_impossibility",
        "self_admitted",
        "authoritative",
        "prediction_authoritative",
        "prediction_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-prediction@1"
        },
        "query_cid": { "$ref": "#/$defs/cid" },
        "subject_cid": { "$ref": "#/$defs/cid" },
        "model_profile_cid": { "$ref": "#/$defs/cid" },
        "candidate_cids": { "$ref": "#/$defs/cidArrayOrderedBounded" },
        "evidence_cids": { "$ref": "#/$defs/cidArraySet" },
        "environment_binding_cid": { "$ref": "#/$defs/cidOrNull" },
        "policy_cid": { "$ref": "#/$defs/cidOrNull" },
        "calibration_cid": { "$ref": "#/$defs/cidOrNull" },
        "abstain": { "type": "boolean" },
        "proposal_only": { "const": true },
        "proves_contract": { "const": false },
        "proves_postcondition": { "const": false },
        "authorizes_mutation": { "const": false },
        "suppresses_validation": { "const": false },
        "suppresses_review": { "const": false },
        "establishes_equivalence": { "const": false },
        "establishes_observation": { "const": false },
        "establishes_completion": { "const": false },
        "invents_hashes": { "const": false },
        "proves_impossibility": { "const": false },
        "self_admitted": { "const": false },
        "authoritative": { "const": false },
        "prediction_authoritative": { "const": false },
        "prediction_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [
        { "$ref": "#/$defs/forbiddenAuthorityFields" },
        {
          "if": {
            "properties": { "abstain": { "const": false } },
            "required": ["abstain"]
          },
          "then": {
            "properties": {
              "candidate_cids": { "minItems": 1, "maxItems": 256 }
            }
          }
        },
        {
          "if": {
            "properties": { "abstain": { "const": true } },
            "required": ["abstain"]
          },
          "then": {
            "properties": {
              "candidate_cids": { "maxItems": 0 }
            }
          }
        }
      ]
    },
    "programTransitionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_cid",
        "subject_cid",
        "observed_cid",
        "observation_status",
        "environment_binding_cid",
        "query_family",
        "evidence_cids",
        "policy_cid",
        "proposal_only",
        "observation_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-observation@1"
        },
        "query_cid": { "$ref": "#/$defs/cid" },
        "subject_cid": { "$ref": "#/$defs/cid" },
        "observed_cid": { "$ref": "#/$defs/cid" },
        "observation_status": { "$ref": "#/$defs/observationStatus" },
        "environment_binding_cid": { "$ref": "#/$defs/cid" },
        "query_family": { "$ref": "#/$defs/queryFamily" },
        "evidence_cids": { "$ref": "#/$defs/cidArraySet" },
        "policy_cid": { "$ref": "#/$defs/cidOrNull" },
        "proposal_only": { "const": false },
        "observation_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [
        { "$ref": "#/$defs/forbiddenAuthorityFields" },
        {
          "not": {
            "anyOf": [
              { "required": ["model_profile_cid"] },
              { "required": ["prediction_cid"] },
              { "required": ["proves_contract"] },
              { "required": ["authorizes_mutation"] }
            ]
          }
        }
      ]
    },
    "programTransitionAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_cid",
        "policy_cid",
        "current_subject_cid",
        "current_environment_binding_cid",
        "verdict",
        "prediction_cid",
        "observation_cid",
        "validation_evidence_cids",
        "limitation_cids",
        "prediction_authoritative",
        "authorizes_mutation",
        "suppresses_validation",
        "suppresses_review",
        "establishes_completion",
        "establishes_equivalence",
        "admission_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-admission@1"
        },
        "query_cid": { "$ref": "#/$defs/cid" },
        "policy_cid": { "$ref": "#/$defs/cid" },
        "current_subject_cid": { "$ref": "#/$defs/cid" },
        "current_environment_binding_cid": { "$ref": "#/$defs/cid" },
        "verdict": { "$ref": "#/$defs/admissionVerdict" },
        "prediction_cid": { "$ref": "#/$defs/cidOrNull" },
        "observation_cid": { "$ref": "#/$defs/cidOrNull" },
        "validation_evidence_cids": { "$ref": "#/$defs/cidArraySet" },
        "limitation_cids": { "$ref": "#/$defs/cidArraySet" },
        "prediction_authoritative": { "const": false },
        "authorizes_mutation": { "const": false },
        "suppresses_validation": { "const": false },
        "suppresses_review": { "const": false },
        "establishes_completion": { "const": false },
        "establishes_equivalence": { "const": false },
        "admission_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [
        { "$ref": "#/$defs/forbiddenAuthorityFields" },
        {
          "if": {
            "properties": { "verdict": { "const": "admitted" } },
            "required": ["verdict"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "observation_cid": { "$ref": "#/$defs/cid" }
                }
              },
              {
                "properties": {
                  "validation_evidence_cids": { "minItems": 1 }
                }
              }
            ]
          }
        }
      ]
    },
    "programTransitionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "query_cid",
        "admission_cid",
        "verdict",
        "prediction_cid",
        "observation_cid",
        "may_influence_planning",
        "prediction_authoritative",
        "receipt_cid"
      ],
      "properties": {
        "schema": {
          "const": "ipfs-datasets.software-contracts.program-transition-receipt@1"
        },
        "query_cid": { "$ref": "#/$defs/cid" },
        "admission_cid": { "$ref": "#/$defs/cid" },
        "verdict": { "$ref": "#/$defs/admissionVerdict" },
        "prediction_cid": { "$ref": "#/$defs/cidOrNull" },
        "observation_cid": { "$ref": "#/$defs/cidOrNull" },
        "may_influence_planning": { "type": "boolean" },
        "prediction_authoritative": { "const": false },
        "receipt_cid": { "$ref": "#/$defs/cid" }
      },
      "allOf": [
        { "$ref": "#/$defs/forbiddenAuthorityFields" },
        {
          "if": {
            "properties": { "may_influence_planning": { "const": true } },
            "required": ["may_influence_planning"]
          },
          "then": {
            "properties": {
              "verdict": { "const": "admitted" },
              "observation_cid": { "$ref": "#/$defs/cid" },
              "prediction_authoritative": { "const": false }
            }
          }
        }
      ]
    }
  }
}
