        "requirement_id": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["input", "output"] },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-collection-semantics": "set-like",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "essential": { "type": "boolean", "default": true },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "modalityAlternative": {
      "type": "object",
