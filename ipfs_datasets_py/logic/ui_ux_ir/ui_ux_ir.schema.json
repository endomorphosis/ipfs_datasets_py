        "localization_id": { "$ref": "#/$defs/identifier" },
        "message_id": { "$ref": "#/$defs/nonEmptyString" },
        "default_text": { "type": "string", "default": "" },
        "variable_ids": { "$ref": "#/$defs/identifierSet" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "modalityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "direction", "capability_ids"],
