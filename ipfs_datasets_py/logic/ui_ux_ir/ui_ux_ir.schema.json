        "capability_predicate_ids": { "$ref": "#/$defs/identifierSet" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "dataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "kind", "resource_ref"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "resource_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "kind", "resource_ref"],
      "properties": {
        "content_id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/nonEmptyString" },
        "resource_ref": { "$ref": "#/$defs/nonEmptyString" },
        "localization_id": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/identifier" }
          ],
          "default": ""
        },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "programBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "target_kind", "target_ref"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/identifier" },
        "target_kind": {
          "enum": [
            "mcp_idl_interface_method_schema",
            "intent_ir_document_action",
            "invocation_intent_template",
            "local_state_only_transition",
            "versioned_composite_workflow"
          ]
        },
        "target_ref": { "$ref": "#/$defs/nonEmptyString" },
        "risk_class": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "low"
        },
        "confirmation_class": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "none"
        },
        "precondition_ids": { "$ref": "#/$defs/identifierSet" },
        "effect_ids": { "$ref": "#/$defs/identifierSet" },
        "verification_ids": { "$ref": "#/$defs/identifierSet" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "intentIrBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "intent_document_id"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/identifier" },
        "intent_document_id": { "$ref": "#/$defs/identifier" },
        "intent_action_id": {
          "oneOf": [
            { "const": "" },
            { "$ref": "#/$defs/identifier" }
          ],
          "default": ""
        },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "invocationBinding": {
      "type": "object",
      "additionalProperties": false,
