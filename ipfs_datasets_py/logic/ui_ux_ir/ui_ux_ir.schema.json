        "template_cid": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "mcpIdlBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "interface_cid", "method_name"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/identifier" },
        "interface_cid": { "$ref": "#/$defs/nonEmptyString" },
        "method_name": { "$ref": "#/$defs/nonEmptyString" },
        "argument_schema_ref": { "type": "string", "default": "" },
        "result_schema_ref": { "type": "string", "default": "" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "formalConstraintRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "view", "formula_ref"],
      "properties": {
        "constraint_id": { "$ref": "#/$defs/identifier" },
        "view": { "$ref": "#/$defs/nonEmptyString" },
        "formula_ref": { "$ref": "#/$defs/nonEmptyString" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "proofObligationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "constraint_id"],
      "properties": {
        "obligation_id": { "$ref": "#/$defs/identifier" },
        "constraint_id": { "$ref": "#/$defs/identifier" },
        "prover": { "type": "string", "default": "" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "terminalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "kind"],
      "properties": {
        "outcome_id": { "$ref": "#/$defs/identifier" },
        "kind": { "$ref": "#/$defs/terminalOutcomeKind" },
        "description": { "type": "string", "default": "" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "namespacedExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_id", "namespace", "version"],
      "properties": {
        "extension_id": { "$ref": "#/$defs/identifier" },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(\\.[A-Za-z][A-Za-z0-9_-]{0,63}){0,7}$",
          "not": {
            "pattern": "^(observation|telemetry|projection|proof|policy_result|runtime)(\\..*)?$"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "payload": {
          "$ref": "#/$defs/jsonObject",
          "default": {}
        },
        "required": { "type": "boolean", "default": false },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    }
  }
}
