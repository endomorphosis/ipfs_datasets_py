      "properties": {
        "alternative_id": { "$ref": "#/$defs/identifier" },
        "primary_requirement_id": { "$ref": "#/$defs/identifier" },
        "alternative_requirement_id": { "$ref": "#/$defs/identifier" },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "deviceCapabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "capability_ids"],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/identifier" },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "x-collection-semantics": "set-like",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "source_ref_ids": { "$ref": "#/$defs/identifierSet" }
      }
    },
    "adaptiveVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "adaptation_policy"],
      "properties": {
