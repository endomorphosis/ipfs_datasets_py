        "input_corpus_rows_digest_sha256", "release_corpus_rows_digest_sha256",
        "release_corpus_shards", "release_corpus_shards_digest_sha256"
      ],
      "properties": {
        "jurisdiction": { "$ref": "#/$defs/jurisdictionCode" },
        "admitted_row_count": { "type": "integer", "minimum": 1 },
        "adapter_dispositions": { "$ref": "#/$defs/adapterDispositions" },
        "input_entry_cids_digest_sha256": { "$ref": "#/$defs/sha256" },
        "release_entry_cids_digest_sha256": { "$ref": "#/$defs/sha256" },
        "input_corpus_rows_digest_sha256": { "$ref": "#/$defs/sha256" },
        "release_corpus_rows_digest_sha256": { "$ref": "#/$defs/sha256" },
        "release_corpus_shards": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/corpusShard" }
        },
        "release_corpus_shards_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "union": {
      "type": "object", "additionalProperties": false,
      "required": [
        "shard_sum_before_dedup", "deduped_union_count", "duplicate_row_count",
        "deduped_entry_cids_digest_sha256", "deduped_corpus_rows_digest_sha256",
        "input_source_receipts_digest_sha256",
        "release_source_receipts_digest_sha256", "per_jurisdiction"
      ],
      "properties": {
        "shard_sum_before_dedup": { "type": "integer", "minimum": 51 },
        "deduped_union_count": { "type": "integer", "minimum": 51 },
        "duplicate_row_count": { "const": 0 },
        "deduped_entry_cids_digest_sha256": { "$ref": "#/$defs/sha256" },
        "deduped_corpus_rows_digest_sha256": { "$ref": "#/$defs/sha256" },
        "input_source_receipts_digest_sha256": { "$ref": "#/$defs/sha256" },
        "release_source_receipts_digest_sha256": { "$ref": "#/$defs/sha256" },
        "per_jurisdiction": {
          "type": "array", "minItems": 51, "maxItems": 51,
          "items": { "$ref": "#/$defs/jurisdictionRows" }
        }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authenticated_live_baseline", "baseline_reconciliation", "input_map",
        "jurisdictions", "official_frontier_reobservation",
        "production_release", "rights_receipt", "source_bundle", "source_control",
        "source_receipts_digest_sha256", "union"
      ],
      "properties": {
        "authenticated_live_baseline": { "$ref": "#/$defs/authenticatedBaseline" },
        "baseline_reconciliation": {
          "type": "array", "minItems": 51, "maxItems": 51,
          "items": { "$ref": "#/$defs/baselineReconciliation" }
        },
        "input_map": { "$ref": "#/$defs/inputMap" },
        "jurisdictions": {
          "type": "array", "minItems": 51, "maxItems": 51,
          "items": { "$ref": "#/$defs/jurisdictionEvidence" }
        },
        "official_frontier_reobservation": {
          "$ref": "#/$defs/officialFrontierReobservation"
        },
        "production_release": { "$ref": "#/$defs/productionRelease" },
        "rights_receipt": { "$ref": "#/$defs/rightsReceipt" },
        "source_bundle": { "$ref": "#/$defs/sourceBundle" },
        "source_control": { "$ref": "#/$defs/sourceControl" },
        "source_receipts_digest_sha256": { "$ref": "#/$defs/sha256" },
        "union": { "$ref": "#/$defs/union" }
      }
    }
  }
}
