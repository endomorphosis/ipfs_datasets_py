        },
        "function": {
          "$ref": "#/$defs/non_empty_string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "write_method": {
          "enum": [
            "accept_access_request",
