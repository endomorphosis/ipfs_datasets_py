            "delete_file",
            "delete_files",
            "delete_folder",
            "delete_repo",
            "delete_tag",
            "edit_discussion_comment",
            "grant_access",
            "hide_discussion_comment",
            "merge_pull_request",
            "move_repo",
            "permanently_delete_lfs_files",
            "preupload_lfs_files",
            "reject_access_request",
            "rename_discussion",
            "super_squash_history",
            "update_repo_settings",
            "update_repo_visibility",
            "upload_file",
            "upload_folder",
            "upload_large_folder"
          ]
        },
        "call_expression": {
          "$ref": "#/$defs/non_empty_string"
        },
        "repo_expression": {
          "type": "string"
        },
        "repo_roots": {
          "$ref": "#/$defs/strings"
        },
        "protected_repos": {
          "$ref": "#/$defs/unique_strings"
        },
        "protected_target": {
          "type": "boolean"
        },
        "potential_protected_target": {
          "type": "boolean"
        },
        "canonical_callback": {
          "type": "boolean"
        },
        "attested_executor": {
          "type": "boolean"
        },
        "api_or_method_constructed_after_guard": {
          "type": "boolean"
        },
        "api_primitive_attested": {
          "type": "boolean"
        },
        "api_primitive_exact_call": {
          "type": "boolean"
        },
        "prepared_binding_exact": {
          "type": "boolean"
        },
        "guarded_write_exact_binding": {
          "type": "boolean"
        },
        "guarded_write_individual": {
          "type": "boolean"
        },
        "guarded_write_id": {
          "type": "string"
        },
        "guarded_write_line": {
          "type": "integer",
          "minimum": 0
        },
        "guard_lines": {
          "$ref": "#/$defs/line_numbers"
        },
        "exact_binding_guard_lines": {
          "$ref": "#/$defs/line_numbers"
        },
        "guarded_write_lines": {
          "$ref": "#/$defs/line_numbers"
        },
        "analysis_context_count": {
          "type": "integer",
          "minimum": 1
        },
        "protection_variants": {
          "$ref": "#/$defs/unique_strings"
        },
        "protection": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "hard_rejected_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "function",
        "line",
        "selector",
        "selector_expression",
        "mechanism"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "function": {
          "$ref": "#/$defs/non_empty_string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "selector": {
          "$ref": "#/$defs/non_empty_string"
        },
        "selector_expression": {
          "$ref": "#/$defs/non_empty_string"
        },
