      "const": false
    },
    "status": {
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unique_strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "line_numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path_digest_algorithm",
        "scan_roots",
        "scanned_python_count",
        "scanned_python_paths_sha256",
        "exclusion_policy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "git_tracked_production_python",
            "explicit_scan_roots"
          ]
        },
        "path_digest_algorithm": {
          "const": "sha256-canonical-json-string-array-v1"
        },
        "scan_roots": {
          "$ref": "#/$defs/unique_strings"
        },
        "tracked_python_count": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_python_paths_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scanned_python_count": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_python_paths_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "excluded_python_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_python_paths_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exclusion_policy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_scope_exclusion"
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "git_tracked_production_python"
            },
            "scan_roots": {
              "maxItems": 0
            },
            "exclusion_policy": {
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "tracked_python_count",
            "tracked_python_paths_sha256",
            "excluded_python_count",
            "excluded_python_paths_sha256"
          ]
        },
        {
          "properties": {
            "mode": {
              "const": "explicit_scan_roots"
            },
            "exclusion_policy": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "source_scope_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "path_components",
        "reason",
        "excluded_python_count",
        "excluded_python_paths_sha256"
      ],
      "properties": {
        "category": {
          "enum": [
            "archive",
            "vendor",
            "generated",
            "tests"
          ]
        },
        "path_components": {
          "$ref": "#/$defs/unique_strings"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "excluded_python_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_python_paths_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "archive"
              }
            }
          },
          "then": {
            "properties": {
              "path_components": {
                "const": [
                  "archive",
                  "archives"
                ]
              },
              "reason": {
                "const": "retired archive trees are not runtime code"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "vendor"
              }
            }
          },
          "then": {
            "properties": {
              "path_components": {
                "const": [
                  "external",
                  "third-party",
                  "third_party",
                  "vendor",
                  "vendors"
                ]
              },
              "reason": {
                "const": "vendored or externally maintained trees are not repository runtime code"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "generated"
              }
            }
          },
          "then": {
            "properties": {
              "path_components": {
                "const": [
                  "build",
                  "dist",
                  "generated"
                ]
              },
              "reason": {
                "const": "generated build outputs are not maintained runtime sources"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "tests"
              }
            }
          },
          "then": {
            "properties": {
              "path_components": {
                "const": [
                  "test",
                  "testing",
                  "tests"
                ]
              },
              "reason": {
                "const": "test-only trees are not production runtime code"
              }
            }
          }
        }
      ]
    },
    "callsite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "function",
        "line",
        "column",
        "write_method",
        "call_expression",
        "repo_expression",
        "repo_roots",
        "protected_repos",
        "protected_target",
        "potential_protected_target",
        "canonical_callback",
        "attested_executor",
        "api_or_method_constructed_after_guard",
        "api_primitive_attested",
        "api_primitive_exact_call",
        "prepared_binding_exact",
        "guarded_write_exact_binding",
        "guarded_write_individual",
        "guarded_write_id",
        "guarded_write_line",
        "guard_lines",
        "exact_binding_guard_lines",
        "guarded_write_lines",
        "analysis_context_count",
        "protection_variants",
        "protection",
        "reason"
      ],
      "properties": {
        "path": {
