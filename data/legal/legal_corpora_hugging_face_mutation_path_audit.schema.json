      "type": "integer",
      "minimum": 0
    },
    "protected_callsite_count": {
      "type": "integer",
      "minimum": 0
    },
    "unprotected_count": {
      "type": "integer",
      "minimum": 0
    },
    "callsites": {
      "type": "array",
