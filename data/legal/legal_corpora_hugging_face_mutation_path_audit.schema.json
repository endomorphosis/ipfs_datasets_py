    },
    "producer": {
      "const": "audit_legal_corpora_hugging_face_mutation_paths.py"
    },
    "program_id": {
      "const": "legal-corpora-reindex-v1"
    },
    "task_id": {
      "const": "LCR-084"
    },
    "goal_id": {
      "const": "LCR-G146"
    },
    "source_scope": {
      "$ref": "#/$defs/source_scope"
    },
    "required_runtime": {
