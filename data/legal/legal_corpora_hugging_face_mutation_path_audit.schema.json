        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "error_type": {
          "const": "SyntaxError"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "syntax_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
