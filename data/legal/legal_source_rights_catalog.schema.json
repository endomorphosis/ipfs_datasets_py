{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipfs-datasets.dev/schemas/legal-source-rights-catalog-v2.schema.json",
  "title": "Legal Source Rights Catalog v2",
  "description": "LCR-082 evaluator-complete source-rights catalog. Exact fixture tuple: LCR-082/LCR-G144/fixture. Exact live tuple: LCR-078/LCR-G141/live. All evidence carries immutable bytes and independently recomputed digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "program_id",
    "task_id",
    "goal_id",
    "evidence_mode",
    "policy_schema_version",
    "sealed_at",
    "authorizing_for_publication",
    "target_dataset_repo_ids",
    "artifact_digests",
    "expected_scope_frontier_sha256",
    "admitted_record_ids",
    "description",
    "currentness_disclaimer",
    "records",
    "catalog_digest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "legal-source-rights-catalog-v2" },
    "producer": { "const": "audit_legal_source_rights.py@2" },
    "program_id": { "const": "legal-corpora-reindex-v1" },
    "task_id": { "enum": ["LCR-082", "LCR-078"] },
    "goal_id": { "enum": ["LCR-G144", "LCR-G141"] },
    "evidence_mode": { "enum": ["fixture", "live"] },
    "policy_schema_version": { "const": "legal-source-rights-policy-v2" },
    "sealed_at": { "$ref": "#/$defs/utcTimestamp" },
    "authorizing_for_publication": { "type": "boolean" },
    "target_dataset_repo_ids": {
      "const": [
        "justicedao/ipfs_state_laws",
        "justicedao/ipfs_federal_register"
      ]
    },
    "artifact_digests": { "$ref": "#/$defs/artifactDigests" },
    "expected_scope_frontier_sha256": { "$ref": "#/$defs/sha256" },
    "admitted_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "currentness_disclaimer": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "records": {
      "type": "array",
      "minItems": 57,
      "maxItems": 57,
      "items": { "$ref": "#/$defs/sourceRightsRecord" }
    },
    "catalog_digest_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_mode": { "const": "fixture" } }, "required": ["evidence_mode"] },
      "then": {
        "properties": {
          "task_id": { "const": "LCR-082" },
          "goal_id": { "const": "LCR-G144" },
          "authorizing_for_publication": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "evidence_mode": { "const": "live" } }, "required": ["evidence_mode"] },
      "then": {
        "properties": {
          "task_id": { "const": "LCR-078" },
          "goal_id": { "const": "LCR-G141" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s#]+$"
    },
    "canonicalSourceUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^https?://[^\\s#]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+\\-]{0,159}$"
    },
    "base64Bytes": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4000000,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_module_sha256",
        "schema_sha256",
        "spdx_registry_sha256",
        "lcr002_source_catalog_sha256",
        "lcr048_federal_baseline_sha256",
        "expected_scope_frontier_sha256"
      ],
      "properties": {
        "policy_module_sha256": { "$ref": "#/$defs/sha256" },
        "schema_sha256": { "$ref": "#/$defs/sha256" },
        "spdx_registry_sha256": { "$ref": "#/$defs/sha256" },
        "lcr002_source_catalog_sha256": { "$ref": "#/$defs/sha256" },
        "lcr048_federal_baseline_sha256": { "$ref": "#/$defs/sha256" },
        "expected_scope_frontier_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_kind",
        "producer",
        "program_id",
        "task_id",
        "goal_id",
        "evidence_mode",
        "verifier_id",
        "source_id",
        "content_scope",
        "url",
        "verifier_observed_at",
        "content_bytes_base64",
        "content_sha256",
        "evidence_digest_sha256"
      ],
      "properties": {
        "schema_version": { "const": "legal-source-rights-evidence-v1" },
        "evidence_kind": { "enum": ["terms", "robots"] },
        "producer": { "const": "audit_legal_source_rights.py@2" },
        "program_id": { "const": "legal-corpora-reindex-v1" },
        "task_id": { "enum": ["LCR-082", "LCR-078"] },
        "goal_id": { "enum": ["LCR-G144", "LCR-G141"] },
        "evidence_mode": { "enum": ["fixture", "live"] },
        "verifier_id": { "const": "legal-source-rights-verifier@1" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "content_scope": { "$ref": "#/$defs/contentScope" },
        "url": { "$ref": "#/$defs/canonicalSourceUrl" },
        "verifier_observed_at": { "$ref": "#/$defs/utcTimestamp" },
        "content_bytes_base64": { "$ref": "#/$defs/base64Bytes" },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_digest_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_mode": { "const": "fixture" } }, "required": ["evidence_mode"] },
          "then": { "properties": { "task_id": { "const": "LCR-082" }, "goal_id": { "const": "LCR-G144" } } }
        },
        {
          "if": { "properties": { "evidence_mode": { "const": "live" } }, "required": ["evidence_mode"] },
          "then": { "properties": { "task_id": { "const": "LCR-078" }, "goal_id": { "const": "LCR-G141" } } }
        }
      ]
    },
    "conditionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "producer",
        "program_id",
        "task_id",
        "goal_id",
        "evidence_mode",
        "verifier_id",
        "condition_id",
        "source_id",
        "content_scope",
        "verifier_observed_at",
        "request_bytes_base64",
        "request_sha256",
        "response_bytes_base64",
        "response_sha256",
        "receipt_digest_sha256"
      ],
      "properties": {
        "schema_version": { "const": "legal-source-rights-condition-evidence-v1" },
        "producer": { "const": "audit_legal_source_rights.py@2" },
        "program_id": { "const": "legal-corpora-reindex-v1" },
        "task_id": { "enum": ["LCR-082", "LCR-078"] },
        "goal_id": { "enum": ["LCR-G144", "LCR-G141"] },
        "evidence_mode": { "enum": ["fixture", "live"] },
        "verifier_id": { "const": "legal-source-rights-verifier@1" },
        "condition_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "content_scope": { "$ref": "#/$defs/contentScope" },
        "verifier_observed_at": { "$ref": "#/$defs/utcTimestamp" },
        "request_bytes_base64": { "$ref": "#/$defs/base64Bytes" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "response_bytes_base64": { "$ref": "#/$defs/base64Bytes" },
        "response_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_digest_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_mode": { "const": "fixture" } }, "required": ["evidence_mode"] },
          "then": { "properties": { "task_id": { "const": "LCR-082" }, "goal_id": { "const": "LCR-G144" } } }
        },
        {
          "if": { "properties": { "evidence_mode": { "const": "live" } }, "required": ["evidence_mode"] },
          "then": { "properties": { "task_id": { "const": "LCR-078" }, "goal_id": { "const": "LCR-G141" } } }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redistribution", "derivatives", "archive"],
      "properties": {
        "redistribution": { "type": "boolean" },
        "derivatives": { "type": "boolean" },
        "archive": { "type": "boolean" }
      }
    },
    "contentScope": {
      "enum": [
        "statutory_text",
        "federal_government_text",
        "site_presentation",
        "annotations",
        "editorial_enhancements",
        "database_content"
      ]
    },
    "sourceRightsRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "source_id",
        "corpus_family",
        "dataset_repo_id",
        "content_scope",
        "rights_disposition",
        "license_spdx",
        "license_ref_digest_sha256",
        "legal_basis",
        "terms",
        "robots",
        "robots_access_disposition",
        "access_conditions",
        "condition_evidence",
        "permissions",
        "attribution_notice",
        "review_status",
        "reviewed_at",
        "sealed_at",
        "source_url",
        "jurisdiction_or_authority",
        "card_label_is_not_authority",
        "dataset_card_label",
        "notes"
      ],
      "properties": {
        "record_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "corpus_family": { "enum": ["state_laws", "federal_register"] },
        "dataset_repo_id": {
          "enum": [
            "justicedao/ipfs_state_laws",
            "justicedao/ipfs_federal_register"
          ]
        },
        "content_scope": { "$ref": "#/$defs/contentScope" },
        "rights_disposition": {
          "enum": ["allowed", "conditional", "prohibited", "unknown", "unsupported", "quarantined"]
        },
        "license_spdx": { "type": "string", "minLength": 1, "maxLength": 160 },
        "license_ref_digest_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "legal_basis": {
          "enum": [
            "us_government_work",
            "government_edicts_doctrine",
            "public_domain",
            "explicit_license",
            "statutory_permission",
            "unknown",
            "proprietary",
            "not_applicable"
          ]
        },
        "terms": { "$ref": "#/$defs/evidenceArtifact" },
        "robots": { "$ref": "#/$defs/evidenceArtifact" },
        "robots_access_disposition": {
          "enum": ["allowed", "conditional", "denied", "unknown", "unavailable"]
        },
        "access_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "condition_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionEvidence" }
        },
        "permissions": { "$ref": "#/$defs/permissions" },
        "attribution_notice": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "review_status": { "enum": ["reviewed", "unreviewed", "rejected", "expired"] },
        "reviewed_at": { "$ref": "#/$defs/utcTimestamp" },
        "sealed_at": { "$ref": "#/$defs/utcTimestamp" },
        "source_url": { "$ref": "#/$defs/canonicalSourceUrl" },
        "jurisdiction_or_authority": { "type": "string", "minLength": 1, "maxLength": 128 },
        "card_label_is_not_authority": { "const": true },
        "dataset_card_label": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "notes": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
