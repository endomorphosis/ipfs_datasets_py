{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipfs-datasets.dev/schemas/open-us-law-cohort-evidence-v1.schema.json",
  "title": "Open US Law Cohort Evidence v1",
  "description": "Fail-closed cohort evidence envelope for official Open US Law acquisition (OUL-049 bridge). Offline certification rehashes retained response bodies, frontiers, canonical rows, and CIDs. Fixture execution proves software behavior only and never marks a cohort complete. raw_bytes_checked=false, zero-row success, placeholders, samples, and self-asserted digests are structurally forbidden on a live-complete report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "goal_id",
    "program_id",
    "producer",
    "cohort",
    "jurisdictions",
    "status",
    "mode",
    "authorizing_for_publication",
    "cohort_complete",
    "fixture_execution",
    "fixture_proves_cohort_completion",
    "jurisdiction_receipts",
    "certification",
    "checks",
    "report_digest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "open-us-law-cohort-evidence-v1" },
    "kind": { "const": "cohort_evidence" },
    "task_id": {
      "type": "string",
      "pattern": "^OUL-[0-9]{3}$"
    },
    "goal_id": { "const": "OUL-G021" },
    "program_id": { "const": "open-us-law-reindex-v1" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "code_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "sealed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "cohort": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L", "M"]
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/postalCode" }
    },
    "status": {
      "type": "string",
      "enum": ["success", "passed", "incomplete", "fail", "failed"]
    },
    "mode": { "const": "full" },
    "authorizing_for_publication": { "const": false },
    "cohort_complete": { "type": "boolean" },
    "fixture_execution": { "type": "boolean" },
    "fixture_proves_cohort_completion": { "const": false },
    "jurisdiction_receipts": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "certification": { "$ref": "#/$defs/certificationBlock" },
    "checks": { "$ref": "#/$defs/checksBlock" },
    "evidence_root": { "type": "string", "maxLength": 4096 },
    "notes": { "type": "string", "maxLength": 4096 },
    "report_digest_sha256": { "$ref": "#/$defs/sha256Hex" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cohort_complete": { "const": true }
        },
        "required": ["cohort_complete"]
      },
      "then": {
        "properties": {
          "status": { "enum": ["success", "passed"] },
          "fixture_execution": { "const": false },
          "certification": {
            "properties": {
              "raw_bytes_checked": { "const": true }
            },
            "required": ["raw_bytes_checked"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "fixture_execution": { "const": true }
        },
        "required": ["fixture_execution"]
      },
      "then": {
        "properties": {
          "cohort_complete": { "const": false },
          "status": { "enum": ["incomplete", "fail", "failed"] }
        }
      }
    }
  ],
  "$defs": {
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "postalCode": {
      "type": "string",
      "enum": [
        "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA",
        "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD",
        "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ",
        "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC",
        "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY",
        "DC"
      ]
    },
    "certificationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline", "raw_bytes_checked", "jurisdictions"],
      "properties": {
        "offline": { "const": true },
        "raw_bytes_checked": { "type": "boolean" },
        "jurisdictions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ok": { "type": "boolean" },
              "raw_bytes_checked": { "type": "boolean" },
              "fixture": { "type": "boolean" },
              "row_count": { "type": "integer", "minimum": 0 },
              "rejection_kinds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "checksBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_bytes_checked_required",
        "zero_row_success_rejected",
        "placeholders_rejected",
        "samples_rejected",
        "self_asserted_digests_rejected",
        "fixture_never_completes_cohort",
        "official_hosts_required",
        "closed_boundary_probes_required"
      ],
      "properties": {
        "raw_bytes_checked_required": { "const": true },
        "zero_row_success_rejected": { "const": true },
        "placeholders_rejected": { "const": true },
        "samples_rejected": { "const": true },
        "self_asserted_digests_rejected": { "const": true },
        "fixture_never_completes_cohort": { "const": true },
        "official_hosts_required": { "const": true },
        "closed_boundary_probes_required": { "const": true }
      }
    }
  }
}
