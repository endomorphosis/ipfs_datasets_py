      "record_kinds": [
        "hermetic_fixture"
      ]
    },
    "scheduled_process": {
      "lane_id": "scheduled_process",
      "description": "Optional pinned-binary subprocess tier. Real binaries when available; typed unavailable receipts otherwise.",
