      "surface": "mcp process_dataset",
      "path": "ipfs_datasets_py/ipfs_datasets_py/mcp_server/tools/dataset_tools/process_dataset.py",
      "behavior": "reject_dangerous_operation_types",
      "inputs": {
        "dataset_source": {"data": [{"id": 1}]},
        "operations": [{"type": "eval"}]
      },
      "expected": {
        "status": "error",
        "error_type": "validation",
        "message_contains": "not allowed"
      },
      "rationale": "Arbitrary code/eval must never become a process success."
    },
    {
      "vector_id": "SAFE-002",
      "surface": "mcp process_dataset",
      "path": "ipfs_datasets_py/ipfs_datasets_py/mcp_server/tools/dataset_tools/process_dataset.py",
      "behavior": "reject_exec_operation_types",
      "inputs": {
        "dataset_source": {"data": [{"id": 1}]},
        "operations": [{"type": "exec"}]
      },
      "expected": {
        "status": "error",
        "error_type": "validation"
      },
      "rationale": "exec is blocked by the same dangerous-ops allowlist."
    },
    {
      "vector_id": "SAFE-003",
      "surface": "mcp process_dataset",
      "path": "ipfs_datasets_py/ipfs_datasets_py/mcp_server/tools/dataset_tools/process_dataset.py",
      "behavior": "reject_empty_operations",
      "inputs": {
        "dataset_source": {"data": [{"id": 1}]},
        "operations": []
      },
      "expected": {
        "status": "error",
        "error_type": "validation"
      },
      "rationale": "Empty operations list is validation-rejected."
    },
    {
      "vector_id": "SAFE-004",
      "surface": "mcp save_dataset",
      "path": "ipfs_datasets_py/ipfs_datasets_py/mcp_server/tools/dataset_tools/save_dataset.py",
      "behavior": "reject_executable_destination",
      "inputs": {
        "dataset_data": {"data": [{"id": 1}]},
        "destination": "/tmp/evil.py",
        "format": "json"
      },
      "expected": {
        "status": "error",
        "message_contains": "executable"
      },
      "rationale": "Refuse writing datasets as executable files."
    },
    {
      "vector_id": "SAFE-005",
      "surface": "core DatasetLoader",
      "path": "ipfs_datasets_py/ipfs_datasets_py/core_operations/dataset_loader.py",
