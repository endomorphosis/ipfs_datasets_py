{
  "schema_version": "logic-provider-conformance/v1",
  "interface": "LogicProviderConformance@1",
  "description": "Cross-family and cross-provider software-verification conformance corpus. Compact recipes generate positive, negative, mutation, metamorphic, translation, disagreement, malformed-output, timeout, and authority-boundary fixtures for every reviewed adapter. Offline fake runners are mandatory; real-tool lanes are opt-in and must declare skips or unavailability.",
  "objective": "LFV-G080",
  "task": "LFV-039",
  "scope": {
    "path_root": "ipfs_datasets_py",
    "offline_required": true,
    "real_tools": {
      "opt_in_env": "LFV_CONFORMANCE_REAL_TOOLS",
      "policy": "When the opt-in environment variable is unset or empty, real-tool lanes must not run. When set, missing binaries must surface as explicit unavailable or pytest.skip, never as success."
    },
    "authority_policy": "Candidates and advisory surfaces never upgrade to theorem or independently-checkable authority. Cache entries cannot store evidence above the translation ceiling. Stale tree or backend identity dimensions must miss, not hit.",
    "disagreement_policy": "Conclusive disagreement between peer authorities quarantines; no winner is selected by presentation order."
  },
  "required_case_kinds": [
    "positive",
    "negative",
    "mutation",
    "metamorphic",
    "translation",
    "disagreement",
    "malformed_output",
    "timeout",
    "authority_boundary"
  ],
  "logic_families": [
    "authorization",
    "concurrency",
    "cryptographic_protocol",
    "datalog",
    "first_order",
    "higher_order",
    "hyperproperty",
    "program",
    "propositional",
    "refinement",
    "separation_logic",
    "temporal",
    "transition_system"
  ],
  "attempt_families": [
