  "recipes": {
    "statement_seed": "forall x. P(x) -> Q(x)",
    "positive": {
      "description": "Well-formed obligation expected to conclude positively under the adapter authority.",
      "statement_template": "{seed}",
      "expected_disposition": "conclusive_positive"
    },
    "negative": {
      "description": "Disproved or violated obligation with an optional counterexample witness.",
      "statement_template": "exists x. P(x) /\\ ~Q(x)",
      "expected_disposition": "conclusive_negative",
      "counterexample": {
        "binding": {"x": 0},
        "trace": ["s0", "s1"]
      }
    },
    "mutation": {
      "description": "Semantic mutations must change the obligation digest and must not reuse positive outcomes.",
      "base_statement": "{seed}",
      "mutations": [
        {
          "mutation_id": "invert_implication",
          "mutated_statement": "forall x. Q(x) -> P(x)",
          "semantic_change": true
        },
        {
          "mutation_id": "drop_quantifier",
          "mutated_statement": "P(a) -> Q(a)",
          "semantic_change": true
        },
        {
          "mutation_id": "negate_goal",
          "mutated_statement": "~(forall x. P(x) -> Q(x))",
          "semantic_change": true
        },
        {
          "mutation_id": "whitespace_only",
          "mutated_statement": "forall  x.  P(x) -> Q(x)",
          "semantic_change": false,
          "normalize": "collapse_whitespace"
        }
      ]
    },
    "metamorphic": {
      "description": "Equivalent reformulations must preserve the offline fake verdict.",
      "pairs": [
        {
          "pair_id": "alpha_rename",
          "left": "forall x. P(x) -> Q(x)",
          "right": "forall y. P(y) -> Q(y)",
          "expect_same_verdict": true
        },
        {
          "pair_id": "commute_and",
          "left": "P(a) /\\ Q(a)",
          "right": "Q(a) /\\ P(a)",
          "expect_same_verdict": true
        },
        {
          "pair_id": "non_equivalent",
          "left": "forall x. P(x) -> Q(x)",
          "right": "forall x. Q(x) -> P(x)",
          "expect_same_verdict": false
        }
      ]
    },
    "translation": {
      "description": "Translation receipts bind source fragment, target fragment, and authority ceiling.",
      "source_family": "program",
      "target_family": "first_order",
      "preservation": "equisatisfiable",
      "ceiling": "bounded",
      "source_digest_seed": "program:cfg:entry",
      "target_digest_seed": "smt:qf_lia:vc"
    },
    "disagreement": {
      "description": "Peer model-checkers that disagree must quarantine without authority selection.",
      "property_kind": "safety",
      "peer_backend_ids": ["tla_tlc", "apalache"],
      "left_status": "satisfied",
      "right_status": "violated",
      "expected_verdict": "quarantined"
    },
    "malformed_output": {
      "description": "Conflicting or unparseable tool output maps to malformed, never proved.",
      "raw_payloads": [
        "sat\nunsat\n",
        "",
        "??? not a verdict",
        "{\"status\": null}"
      ],
      "expected_status": "malformed"
    },
    "timeout": {
      "description": "Bounded resource exhaustion is typed as timeout and non-conclusive.",
      "timeout_ms": 1,
      "expected_status": "timeout"
    },
    "authority_boundary": {
      "description": "Advisory and candidate surfaces cannot raise authority; cache cannot accept stale or elevated entries.",
      "candidate_adapter_id": "leanstral",
      "forbidden_upgrade_to": "theorem",
      "max_evidence_authority": "advisory",
      "stale_tree_id": "tree:stale-conformance",
      "fresh_tree_id": "tree:fresh-conformance"
    }
  },
  "acceptance": {
    "fake_runners_cover_every_adapter_offline": true,
    "opt_in_real_tool_lanes_declare_skips_or_unavailability": true,
    "semantic_mutations_are_detected": true,
    "counterexamples_replay": true,
    "disagreements_quarantine": true,
    "no_authority_upgrade": true,
    "no_stale_cache_acceptance": true
  },
  "evidence_paths": [
    "ipfs_datasets_py/tests/fixtures/logic/software_verification/conformance/manifest.json",
    "ipfs_datasets_py/tests/integration/logic/test_software_verification_conformance.py"
  ]
}
