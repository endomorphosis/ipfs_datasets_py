  "incompatible_assumptions": [
    {
      "id": "vector_space_same_dim_different_model",
      "kind": "vector_space",
      "left_domain": "cvefixes",
      "right_domain": "skillcenter",
      "expect_error": "VectorSpaceIncompatibilityError",
      "reason": "Both are 384-d but MiniLM and GTE declare distinct vector_space_id values; dimension alone never implies compatibility."
    },
    {
      "id": "vector_space_patent_vs_cvefixes",
      "kind": "vector_space",
      "left_domain": "patent",
      "right_domain": "cvefixes",
      "expect_error": "VectorSpaceIncompatibilityError",
      "reason": "256-d hashed patent projection is not interchangeable with 384-d MiniLM."
    },
    {
      "id": "vector_space_patent_vs_skillcenter",
      "kind": "vector_space",
      "left_domain": "patent",
      "right_domain": "skillcenter",
      "expect_error": "VectorSpaceIncompatibilityError",
      "reason": "Patent hashed projection cannot late-fuse with SkillCenter GTE vectors."
    },
    {
      "id": "graph_ontology_cvefixes_vs_skillcenter",
      "kind": "graph_ontology",
      "left_domain": "cvefixes",
      "right_domain": "skillcenter",
      "expect_error": "GraphOntologyIncompatibilityError",
      "reason": "Security and intent ontologies share adjacency layout families but not node/edge vocabularies."
    },
    {
      "id": "graph_ontology_patent_vs_cvefixes",
      "kind": "graph_ontology",
      "left_domain": "patent",
      "right_domain": "cvefixes",
      "expect_error": "GraphOntologyIncompatibilityError",
      "reason": "Patent claim graph vocabulary is not the CVEfixes security vocabulary."
    },
    {
      "id": "mutable_revision_main",
      "kind": "immutable_resolution",
      "revision": "main",
      "expect_error": "MutableRevisionError",
      "reason": "Branch names are not immutable Hub pins."
    },
    {
      "id": "physical_bound_oversize_rows",
      "kind": "physical_bound",
      "row_count": 4097,
      "expect_error": "PhysicalBoundError",
      "reason": "Physical shard rows may not exceed 4,096."
    },
    {
      "id": "unknown_artifact_family",
      "kind": "artifact_family",
      "family": "skill_blob",
      "expect_error": "HfGraphragSchemaError",
      "reason": "Domain-private families are not part of the shared substrate vocabulary."
    },
    {
      "id": "schema_mismatch_unregistered",
      "kind": "schema_mismatch",
      "domain": "skillcenter",
      "expect_error": "SchemaMismatchError",
      "reason": "Domain release schemas must be explicitly admitted; ambient defaults reject unregistered schemas."
    }
