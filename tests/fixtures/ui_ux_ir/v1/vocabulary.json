  "explicit_rejections": [
    {
      "id": "reject.universal_source_recovery",
      "claim": "universal_source_recovery",
      "status": "rejected",
      "description": "Pixel-perfect or stylistically identical reconstruction of React, SwiftUI, Jetpack Compose, Flutter, CSS, binary UI, or arbitrary original source is out of scope. Semantic equivalence only."
    },
    {
      "id": "reject.raw_emg",
      "claim": "raw_neural_band_emg_access",
      "status": "rejected",
      "description": "Canonical events must not claim raw EMG, continuous neural streams, or unreviewed biometric payload authority. Only normalized Arrow/Enter-style Neural Band intent is modeled."
    },
    {
      "id": "reject.ui_visibility_as_authorization",
      "claim": "ui_visibility_as_authorization",
      "status": "rejected",
      "description": "Hiding, disabling, or omitting a control is never authorization."
    },
    {
      "id": "reject.monitor_as_proof",
      "claim": "monitor_as_proof",
      "status": "rejected",
      "description": "Bounded monitoring and schema validation are not theorem proof."
    },
    {
      "id": "reject.policy_as_proof",
      "claim": "policy_approval_as_formal_proof",
      "status": "rejected",
      "description": "Deontic or policy allow decisions do not prove formulas."
    },
    {
      "id": "reject.synthesis_as_admitted",
      "claim": "learned_synthesis_as_admitted_semantics",
      "status": "rejected",
      "description": "Model-generated candidates are candidate-only until deterministic gates admit them."
    },
    {
      "id": "reject.identity_conflation",
      "claim": "ui_ir_cid_equals_interface_cid",
      "status": "rejected",
      "description": "ui_ir_cid, verified interface_cid, and typed legacy aliases are never interchangeable."
    },
    {
      "id": "reject.replace_landed_authorities",
      "claim": "replace_mcp_idl_intent_orb_ir_core",
      "status": "rejected",
      "description": "UIIR does not replace MCP-IDL, Intent IR, Invocation IR, ORB routing, ir_core, formalization backends, or proof systems."
    }
  ],
