      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "const": "The argument is an exact built-in Python int, excluding bool and subclasses; source annotations do not enforce this."
        },
        {
          "const": "Integer arithmetic uses the unbounded mathematical model; allocation failure, resource exhaustion and asynchronous interruption are excluded from modeled execution."
        },
        {
          "const": "The captured function is called directly with one supplied argument in sequential execution; module loading, rebinding and concurrent code changes are outside the model."
        }
      ],
      "items": false
