structure Store where

  v0 : Int

  v1 : Bool

  v2 : Int

  deriving DecidableEq



inductive Outcome where

  | returned (store : Store) (value : Bool)

  | blocked

  | assertionFailure

  deriving DecidableEq

def expression_0 (initial current : Store) (returned : Bool) : Bool := (decide (current.v0 < current.v2))

def expression_1 (initial current : Store) (returned : Bool) : Int := current.v0

def expression_2 (initial current : Store) (returned : Bool) : Int := current.v2

def run (initial : Store) : Outcome :=
  let current := initial;
  Outcome.returned current (expression_0 initial current false)

