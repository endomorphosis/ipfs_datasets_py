      "sql": "WITH unresolved AS (SELECT a.source_span_id,a.source_sha256,a.legal_id,a.status,a.code_identity FROM read_parquet(?) a WHERE record_kind='span' AND NOT EXISTS (SELECT 1 FROM final.target_occurrences f WHERE f.source_span_id=a.source_span_id)) SELECT u.source_span_id AS archived_id,u.source_sha256,u.legal_id,u.status AS archived_status,u.code_identity AS recorded_archived_code_identity,s.seed_occurrences,s.seed_distinct_ids,s.example_seed_id,s.example_section,s.example_document_batch,s.example_historical_ordinal FROM unresolved u JOIN seed_pairs s USING(legal_id,source_sha256) ORDER BY u.source_span_id LIMIT 256"
