+@pytest.mark.parametrize("statement", [
+    "INSERT INTO missing SELECT ?",
+    "INSERT INTO missing VALUES ()",
+    "INSERT INTO missing VALUES (? + 1)",
+    "INSERT INTO missing VALUES (?,)",
+    "INSERT INTO missing VALUES (?); DROP TABLE ast_blobs",
+])
+def test_fact_insert_rejects_malformed_layout_before_consuming_rows(statement):
+    from ipfs_datasets_py.logic.software_contracts.duckdb_ast_store import DuckDBASTStoreError
+    store = DuckDBASTStore()
+
+    def rows():
+        raise AssertionError("malformed layout consumed rows")
+        yield ()
+
+    with pytest.raises(DuckDBASTStoreError, match="placeholder-only VALUES"):
+        store._insert_rows(statement, rows())
+
+
+def test_fact_insert_empty_rows_and_wrong_width_do_not_execute():
+    from ipfs_datasets_py.logic.software_contracts.duckdb_ast_store import DuckDBASTStoreError
+    store = DuckDBASTStore()
+
+    class NoExecution:
+        def execute(self, *_args, **_kwargs):
+            raise AssertionError("unexpected SQL execution")
+
+    store._connection = NoExecution()
+    store._insert_rows("INSERT INTO missing VALUES (?, ?)", iter(()))
+    with pytest.raises(DuckDBASTStoreError, match="fact row differs"):
+        store._insert_rows("INSERT INTO missing VALUES (?, ?)", iter([(1,)]))
+
+
+def test_native_column_lists_preserve_all_null_columns_and_double_values(database):
+    _, _, connection = database
+    store = DuckDBASTStore(connection=connection)
+    connection.execute("CREATE TEMP TABLE nullable_probe (ordinal BIGINT, text_value VARCHAR, int_value BIGINT, flag BOOLEAN, created_at DOUBLE)")
+    rows = [(i, None, None, None, value)
+            for i, value in enumerate((0.0, -0.0, 1.25, -2.5, 1700000000.125))]
+    store._insert_rows("INSERT INTO nullable_probe VALUES (?, ?, ?, ?, ?)", iter(rows))
+    assert connection.execute("SELECT * FROM nullable_probe ORDER BY ordinal").fetchall() == rows
+
+
+def test_native_chunk_executor_error_keeps_lazy_iteration_and_exact_exception(database):
+    _, _, connection = database
+    store = DuckDBASTStore(connection=connection)
+    connection.execute("CREATE TEMP TABLE lazy_probe (ordinal BIGINT)")
+    consumed = 0
+    failure = RuntimeError("injected after native insert")
+
+    def rows():
+        nonlocal consumed
+        for i in range(1024):
+            consumed += 1
+            yield (i,)
+
+    class RejectAfterNativeInsert:
+        def execute(self, statement, parameters):
+            connection.execute(statement, parameters)
+            assert consumed == 129
+            raise failure
+
+    store._connection = RejectAfterNativeInsert()
+    connection.execute("BEGIN")
+    try:
+        with pytest.raises(RuntimeError) as caught:
+            store._insert_rows("INSERT INTO lazy_probe VALUES (?)", rows())
+        assert caught.value is failure
+        assert consumed == 129
+        assert connection.execute("SELECT count(*) FROM lazy_probe").fetchone() == (128,)
+    finally:
+        connection.execute("ROLLBACK")
+    assert connection.execute("SELECT count(*) FROM lazy_probe").fetchone() == (0,)
+
+
+def test_native_row_generator_error_does_not_flush_pending_chunk(database):
+    _, _, connection = database
+    store = DuckDBASTStore(connection=connection)
+    connection.execute("CREATE TEMP TABLE generator_probe (ordinal BIGINT)")
+    failure = RuntimeError("row producer failed before flush")
+
+    def rows():
+        yield from ((i,) for i in range(128))
+        raise failure
+
+    with pytest.raises(RuntimeError) as caught:
+        store._insert_rows("INSERT INTO generator_probe VALUES (?)", rows())
+    assert caught.value is failure
+    assert connection.execute("SELECT count(*) FROM generator_probe").fetchone() == (0,)
