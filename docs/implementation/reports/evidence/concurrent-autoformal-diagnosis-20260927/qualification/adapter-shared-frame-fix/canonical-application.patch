--- a/tests/unit/logic/legal_ir/test_formalization_adapter.py
+++ b/tests/unit/logic/legal_ir/test_formalization_adapter.py
@@ -306,3 +306,42 @@
     assert "emits no formula" in missing_view_diagnostic.message
